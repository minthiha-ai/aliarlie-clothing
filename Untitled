erDiagram
    USERS {
        bigint id PK
        string name
        string email UK
        timestamp email_verified_at
        string password
        string remember_token
        timestamp created_at
        timestamp updated_at
    }

    PASSWORD_RESET_TOKENS {
        string email PK
        string token
        timestamp created_at
    }

    SESSIONS {
        string id PK
        bigint user_id FK
        string ip_address
        text user_agent
        longtext payload
        integer last_activity
    }

    CATEGORIES {
        bigint id PK
        string name
        string slug UK
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    PRODUCTS {
        bigint id PK
        bigint category_id FK
        string name
        string slug UK
        text description
        decimal price
        decimal discount_price
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    PRODUCT_VARIANTS {
        bigint id PK
        bigint product_id FK
        string sku UK
        string size
        string color
        decimal price
        decimal discount_price
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    PRODUCT_IMAGES {
        bigint id PK
        bigint product_id FK
        string image_path
        boolean is_primary
        timestamp created_at
        timestamp updated_at
    }

    STOCKS {
        bigint id PK
        bigint product_variant_id FK
        integer quantity
        integer reserved
        timestamp created_at
        timestamp updated_at
    }

    CUSTOMERS {
        bigint id PK
        string name
        string phone UK
        string email UK
        timestamp email_verified_at
        string password
        string status
        timestamp created_at
        timestamp updated_at
    }

    CUSTOMER_ADDRESSES {
        bigint id PK
        bigint customer_id FK
        string receiver_name
        string phone
        text address
        string township
        string city
        timestamp created_at
        timestamp updated_at
    }

    CARTS {
        bigint id PK
        bigint customer_id FK
        timestamp created_at
        timestamp updated_at
    }

    CART_ITEMS {
        bigint id PK
        bigint cart_id FK
        bigint product_variant_id FK
        integer quantity
        timestamp created_at
        timestamp updated_at
    }

    ORDERS {
        bigint id PK
        bigint customer_id FK
        string order_code UK
        bigint payment_id FK
        string payment_proof_photo
        enum payment_method
        decimal total_amount
        enum status
        timestamp created_at
        timestamp updated_at
    }

    ORDER_ITEMS {
        bigint id PK
        bigint order_id FK
        bigint product_variant_id FK
        decimal price
        integer quantity
        timestamp created_at
        timestamp updated_at
    }

    ORDER_ADDRESSES {
        bigint id PK
        bigint order_id FK
        enum type
        string receiver_name
        string phone
        string address_line1
        string address_line2
        string township
        string city
        string postal_code
        string country
        timestamp created_at
        timestamp updated_at
    }

    PAYMENTS {
        bigint id PK
        string payment_logo
        string payment_type
        string name
        string number
        string status
        timestamp created_at
        timestamp updated_at
    }

    BANNERS {
        bigint id PK
        string title
        string image_path
        string link
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    USERS ||--o{ SESSIONS : has
    USERS ||--o{ PASSWORD_RESET_TOKENS : has

    CATEGORIES ||--o{ PRODUCTS : has
    PRODUCTS ||--o{ PRODUCT_VARIANTS : has
    PRODUCTS ||--o{ PRODUCT_IMAGES : has
    PRODUCT_VARIANTS ||--o{ STOCKS : has

    CUSTOMERS ||--o{ CUSTOMER_ADDRESSES : has
    CUSTOMERS ||--o{ CARTS : has
    CARTS ||--o{ CART_ITEMS : has

    CUSTOMERS ||--o{ ORDERS : places
    ORDERS ||--o{ ORDER_ITEMS : contains
    ORDERS ||--o{ ORDER_ADDRESSES : ships_to

    PRODUCT_VARIANTS ||--o{ CART_ITEMS : in
    PRODUCT_VARIANTS ||--o{ ORDER_ITEMS : in

    PAYMENTS ||--o{ ORDERS : linked_to